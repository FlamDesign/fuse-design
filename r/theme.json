{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "Flam theme",
  "description": "Flam's colour tokens for light and dark, the brand colour, Rethink Sans and base styles. Uses shadcn/ui token names.",
  "dependencies": [
    "@fontsource-variable/rethink-sans"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "'Rethink Sans Variable', system-ui, sans-serif",
      "font-heading": "var(--font-sans)",
      "color-brand": "var(--brand)",
      "color-brand-foreground": "var(--brand-foreground)"
    },
    "light": {
      "background": "oklch(0.988 0.004 84)",
      "foreground": "oklch(0.216 0.006 56.043)",
      "card": "oklch(1 0 0)",
      "card-foreground": "oklch(0.216 0.006 56.043)",
      "popover": "oklch(1 0 0)",
      "popover-foreground": "oklch(0.216 0.006 56.043)",
      "primary": "oklch(0.216 0.006 56.043)",
      "primary-foreground": "oklch(0.988 0.004 84)",
      "secondary": "oklch(0.954 0.008 84)",
      "secondary-foreground": "oklch(0.216 0.006 56.043)",
      "muted": "oklch(0.954 0.008 84)",
      "muted-foreground": "oklch(0.5 0.013 58.071)",
      "accent": "oklch(0.954 0.008 84)",
      "accent-foreground": "oklch(0.216 0.006 56.043)",
      "destructive": "oklch(0.505 0.213 27.5)",
      "border": "oklch(0.915 0.008 80)",
      "input": "oklch(0.915 0.008 80)",
      "ring": "oklch(0.709 0.01 56.259)",
      "chart-1": "oklch(0.837 0.128 66.29)",
      "chart-2": "oklch(0.705 0.213 47.604)",
      "chart-3": "oklch(0.646 0.222 41.116)",
      "chart-4": "oklch(0.553 0.195 38.402)",
      "chart-5": "oklch(0.47 0.157 37.304)",
      "radius": "0.625rem",
      "brand": "oklch(0.555 0.163 48.998)",
      "brand-foreground": "oklch(0.987 0.022 95.277)",
      "sidebar": "oklch(0.943 0.008 84)",
      "sidebar-foreground": "oklch(0.216 0.006 56.043)",
      "sidebar-primary": "oklch(0.216 0.006 56.043)",
      "sidebar-primary-foreground": "oklch(0.988 0.004 84)",
      "sidebar-accent": "oklch(0.905 0.011 80)",
      "sidebar-accent-foreground": "oklch(0.216 0.006 56.043)",
      "sidebar-border": "oklch(0.9 0.01 80)",
      "sidebar-ring": "oklch(0.709 0.01 56.259)"
    },
    "dark": {
      "background": "oklch(0.235 0.006 56)",
      "foreground": "oklch(0.97 0.002 84)",
      "card": "oklch(0.265 0.007 56)",
      "card-foreground": "oklch(0.97 0.002 84)",
      "popover": "oklch(0.275 0.007 56)",
      "popover-foreground": "oklch(0.97 0.002 84)",
      "primary": "oklch(0.94 0.004 84)",
      "primary-foreground": "oklch(0.216 0.006 56.043)",
      "secondary": "oklch(0.33 0.008 56)",
      "secondary-foreground": "oklch(0.97 0.002 84)",
      "muted": "oklch(0.33 0.008 56)",
      "muted-foreground": "oklch(0.72 0.012 70)",
      "accent": "oklch(0.38 0.009 56)",
      "accent-foreground": "oklch(0.97 0.002 84)",
      "destructive": "oklch(0.8 0.125 22.2)",
      "border": "oklch(1 0 0 / 10%)",
      "input": "oklch(1 0 0 / 14%)",
      "ring": "oklch(0.553 0.013 58.071)",
      "chart-1": "oklch(0.837 0.128 66.29)",
      "chart-2": "oklch(0.705 0.213 47.604)",
      "chart-3": "oklch(0.646 0.222 41.116)",
      "chart-4": "oklch(0.553 0.195 38.402)",
      "chart-5": "oklch(0.47 0.157 37.304)",
      "brand": "oklch(0.56 0.16 47.5)",
      "brand-foreground": "oklch(0.987 0.022 95.277)",
      "sidebar": "oklch(0.2 0.006 56)",
      "sidebar-foreground": "oklch(0.97 0.002 84)",
      "sidebar-primary": "oklch(0.94 0.004 84)",
      "sidebar-primary-foreground": "oklch(0.216 0.006 56.043)",
      "sidebar-accent": "oklch(0.29 0.008 56)",
      "sidebar-accent-foreground": "oklch(0.97 0.002 84)",
      "sidebar-border": "oklch(1 0 0 / 8%)",
      "sidebar-ring": "oklch(0.553 0.013 58.071)"
    }
  },
  "css": {
    "@import \"@fontsource-variable/rethink-sans\"": {},
    "@layer base": {
      ":root": {
        "color-scheme": "light",
        "scrollbar-color": "color-mix(in oklab, var(--foreground) 24%, transparent) transparent"
      },
      ".dark": {
        "color-scheme": "dark"
      },
      "body": {
        "-webkit-font-smoothing": "antialiased",
        "-moz-osx-font-smoothing": "grayscale",
        "text-rendering": "optimizeLegibility"
      },
      "h1, h2, h3": {
        "text-wrap": "balance"
      },
      "::selection": {
        "background": "color-mix(in oklab, var(--brand) 28%, transparent)"
      }
    }
  },
  "type": "registry:theme"
}